DEBUG=False
SECRET_KEY=REMPLACER_PAR_SECRET_ALEATOIRE_LONG
ALLOWED_HOSTS=localhost,127.0.0.1
ERP_LISTEN=127.0.0.1
ERP_PORT=8100
