# Copier ce fichier en .env et l'adapter
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,erp.mondomaine.cm
CSRF_TRUSTED_ORIGINS=https://erp.mondomaine.cm
TIME_ZONE=Africa/Douala

# Base de données : sqlite | postgresql | mssql
DB_ENGINE=postgresql
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=motdepasse
DB_HOST=localhost
DB_PORT=5432

# Exemple SQL Server (base séparée : jamais une base Sage)
# DB_ENGINE=mssql
# DB_NAME=ERP_OHADA
# DB_HOST=NOM-PC\SQLEXPRESS
# Authentification Windows : laisser DB_USER vide. Sinon compte SQL :
# DB_USER=erp
# DB_PASSWORD=motdepasse
# Pilote : vide = ODBC Driver 18 puis 17 ; mssql_python = pilote fourni avec le logiciel
# DB_PYTHON_DRIVER=mssql_python
# DB_EXTRA_PARAMS=TrustServerCertificate=yes
