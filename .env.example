# Copier ce fichier en .env et l'adapter
SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,erp.mondomaine.cm
CSRF_TRUSTED_ORIGINS=https://erp.mondomaine.cm
TIME_ZONE=Africa/Douala

# Base de données : sqlite | postgresql | mssql
DB_ENGINE=postgresql
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=motdepasse
DB_HOST=localhost
DB_PORT=5432

